# Runtime connection (Neon pooled connection string recommended).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require"
# Direct, non-pooled Neon URL used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"
POSTGRES_PASSWORD="replace-with-a-unique-alphanumeric-password"

# Use http://localhost:3000 only for local development; production must use HTTPS.
APP_URL=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_GRAPH_API_VERSION=""
META_CAPI_TEST_EVENT_CODE=""

# Optional transactional email provider; not needed to run locally.
EMAIL_FROM="AIRO XPRESS <no-reply@example.com>"
RESEND_API_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional Cloudinary upload configuration (server-side only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment gateways are deliberately disabled until official merchant credentials
# and verified callback URLs are configured. Never put secrets in NEXT_PUBLIC_*.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
SSL_COMMERZ_STORE_ID=""
SSL_COMMERZ_STORE_PASSWORD=""
